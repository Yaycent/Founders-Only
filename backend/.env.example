PORT=4000
DATABASE_PATH=backend/data/founders_only.sqlite3
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NODE_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENTBOXD_API_KEY=
